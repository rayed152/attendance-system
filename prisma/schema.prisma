// Prisma schema for Multi-Tenant Attendance Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AttendanceType {
  ENTRY
  EXIT
}

model Organization {
  id          String         @id @default(uuid())
  name        String
  companyCode String         @unique
  licenseKey  String         @unique
  logoUrl     String?        // Custom company logo URL or base64
  isVerified  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  users       User[]
  attendances Attendance[]
  warnings    Warning[]
  config      SystemConfig?
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       
  name           String
  passwordHash   String
  role           Role         @default(USER)
  isBlocked      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attendances    Attendance[]
  warnings       Warning[]

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model Attendance {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  type           AttendanceType
  statusFlag     String?        // 'LATE' | 'EARLY_EXIT' | 'ON_TIME'
  note           String?
  timestamp      DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([timestamp])
  @@index([organizationId, userId, timestamp])
}

model Warning {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  message        String
  issuedBy       String       // Admin's userId
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)

  @@index([organizationId])
  @@index([userId])
}

model SystemConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lateEntryTime  String       @default("09:00") // HH:mm format
  earlyExitTime  String       @default("17:00") // HH:mm format
  updatedAt      DateTime     @updatedAt
}
